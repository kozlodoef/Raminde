    "@capacitor/local-notifications": "^8.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.3"
  }
